</nav>
<div class="container">
    <div>
        <h1>List of Video</h1>
        <p id="date"> </p>
        <h5> Thank you for your time for participating in this user study. Here are 22 videos we are asking you to watch and rate them in range of 1 through 5 (5 as the best).
            Each video is 2 minute long. Among these 22 videos, there are only 2 different videos described by 11 different describers. Even though they are repetitive, please 
            listen to each description and rate the description quality and leave comments for each video. At the end, there is a button confirming that I completed all videos. </h5> 
        <br><p><h5>Please select the video</h5></p>
        <br>
          
    </div>
    <br>
    <div class="container">
        <div class="list-group"> 
          
    </div>
    </b>
     <!--iframe src="https://docs.google.com/forms/d/e/1FAIpQLSfwGYCxzlpzy05nsvR74vqMRqUt6DPvIDI2Sy4hsQDktRSwug/viewform?embedded=true" width="640" height="1015" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe-->
</div>

<script>

  //get parameters from query string
let url = location.search.substring(1);
let urlParams = new URLSearchParams(url);
let userId = urlParams.get('userId');
let targetUrl = '/userStudy/helper/video?userId=' + userId;
// console.log('target URL:' +  targetUrl);


$(document).ready(function () {
    getDateTime();
    fetchVideo();
});


function getDateTime(){
    let date = new Date(Date.now()).toLocaleString();
     document.getElementById('date').innerHTML = date;
    // console.log(date);
}


function submitVideoData(userId, status) {
    let jsonBody = {
        "id": userId,
        "status": status,
    };
    $.ajax({
        type: 'PUT',
        url : "/userStudy/updateStatus",
        dataType: "json",
        async:true,
        crossDomain:true,
        data: jsonBody,
        success: function (response) {
            window.alert(JSON.stringify("Thank you for taking part in our study"));
        },
        error: function (response, textStatus, errorThrown) {
            window.alert(JSON.stringify(response));
        }
      });
}


function getVideoData1(userId){
    let url = "/userStudy/helperStatus?userId="+ userId;
      console.log({URL: url});
    $.get(url, function (rows) {
        console.log({LENGTH: rows.length});
        if(rows.length === 22){
            submitVideoData(userId, true);
        }else{
             window.alert("Please rate all the 22 videos");
        }
    });
}

function fetchVideo() {
    $.get(targetUrl, function (rows) {
        let videos = '';
        for (let i = 0; i < rows.length; i++) {
            let vid = rows[i];
            let videoId = vid.video_id;
            let videoTitle = vid.title;
            let volunteerId = vid.volunteer_id;
            let vi_userId= vid.vi_user_id;
            let vi_comment= vid.comment;
            let vi_rating=vid.rating;

            let aiSupportStr = vid.ai_support == 'true' ? 'With AI support' : 'Start from scratch';
            let aiParam = vid.ai_support ? 'yes' : 'no';
            let formid = ""+videoId + volunteerId + aiParam

            videos += `<b><a href="/playvideoaudio/${videoId}?u=${volunteerId}&ai=${aiParam}" class="list-group-item" >

                <img class="vid-thumbnail" src="https://i1.ytimg.com/vi/${videoId}/hqdefault.jpg" alt=${videoTitle} style="width:100px;height:100px;">
                Video ${i+1}: ${videoTitle}</a></b>
                  
                <form data-viuserid="${vi_userId}" data-videoid="${videoId}" data-volunteer_id="${volunteerId}" data-aiParam="${aiParam}"  class="video-form" method="POST">
                   <b><font color="1a4b6e"> Please Rate the above video from 0 to 5:</b></font> <input type="number" min="0" max="5" step="1" id="rating" value=${vi_rating} style="width: 5%; border: 1px solid #ccc; padding: 10px 7px;border-radius: 4px; box-sizing: border-box;" name="rating" required><br>
                   <br>
                   <b><font color="1a4b6e"> Comment:</b></font> <input type="text" id="comment" placeholder= "Please add comment" value= "${vi_comment ? vi_comment : "" }" style= "width: 75%; padding: 10px 7px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" name="comment"><br>
                   <br>
                </form>`;   
                           
        }
        $(".list-group ").append( videos);
        $(".list-group ").append(`<button type="button" onclick= "getVideoData1('${userId}')"> Done and send me Amazon Gift Card!</button>`);
        


        $(".video-form").bind('focusout',function() {
            //$( "#rating", "#comment" ).blur();
           // $( "#input" ).blur();
           $(this).toggleClass("#rating").toggleClass("#comment");


            console.log("Form submitted.")

            let videoId = $(this).data("videoid")
            let volunteerId = $(this).data("volunteer_id")
            let aiParam = $(this).data("aiParam")
            let vi_userId = $(this).data("viuserid")

            var values ={}
            $.each($(this).serializeArray(), function(i, field) {
                values[field.name] = field.value;
            })


            $.ajax({
                type: "POST",
                url:"/updatefeedback",
                data: {
                    vi_user_id: vi_userId,
                    video_id: videoId,
                    volunteer_id: volunteerId,
                    ai_support: aiParam,
                    
                    rating: values["rating"], 
                    comment: values["comment"]
                },
                beforeSend: function() {
                    console.log("Before send.")
                    
                },
                success: function(){
                    console.log("success connected");
                },
                fail: function() {
                    console.log("Failed.")
                },
                dataType: "json"
            })

            return false;
        })
    });

    
}
</script>
