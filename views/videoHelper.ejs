<div class="container">

    <div class="container">
    <div>
        <!--p id="date"> </p-->
        <h5 style= "margin: 20px" id="intro">   </h5> 
        <p style= "margin: 20px"><b>Please play each video once all the way through to the end (there are no pause or rewind functions)</b>
        You are welcome to take a break in between videos. If Youtube video fails to load, then please click on refresh, then the problem goes away. Thank you so much for participating!</p>
        <br>
        <form name= "userInfo" id="userInfo">
        Please enter your email address: <input type="email" name="email" id="email"><br>
        <br>
        <label id="label_access" for="rating_access"> How do you typically prefer to access images?</label> 
        <fieldset class='rating_access' tab-index="0" id="rating_access" aria-describedby="How do you typically prefer to access images?" name="rating">
                <input type="radio" name="rating_access"  aria-labelledby="gdesc1" value="With magnification" > <label id="gdesc1"> With magnification</label><br> </input>
                <input type="radio" name="rating_access"  aria-labelledby="idRely" value="Rely on description">  <label id= "idRely">Rely on description</label><br> </input>
                <input type="radio" name="rating_access" aria-labelledby="idtac" value="Tactile graphic">  <label id="idtac">Tactile graphic</label><br> </input>
                <input type="radio" name="rating_access" value="Other" />  Other : <input name="other" style= "width: 50%" placeholder= "Please enter text for other" id="other" /> <br>
        </fieldset>
        <br>
        <label id="label_freq" for="frequency"> How regularly do you use video descriptions?</label> 
        <fieldset class='freq' id="frequency" name="video_understanding">
                <input type="radio" name="freq" aria-labelledby="1" value="never"> <label id="1">Never</label><br>
                <input type="radio" name="freq" aria-labelledby="2" value="infrequently"> <label id="2">Very infrequently (a few times a year)</label><br>
                <input type="radio" name="freq" aria-labelledby="3" value="sometimes"> <label id="3">Sometimes (a few times a month)</label><br>
                <input type="radio" name="freq" aria-labelledby="4" value="frequently"> <label id="4">Very Frequently (several times a week)</label><br>
                <input type="radio" name="freq" aria-labelledby="5" value="daily"> <label id="5"> Almost daily or daily</label><br>
        </fieldset>
    </form>
        <br>
    </div>
    <br>
    <div class="container">
        <div class="list-group"> 
    </div>
