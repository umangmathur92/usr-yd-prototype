<div class="container">
    <div>
        <p id="date"> </p>
        <h2 id="intro">   </h2> 
        <br>
          
    </div>
    <br>
    <div class="container">
        <div class="list-group"> 
          
    </div>
    </b>
     <!--iframe src="https://docs.google.com/forms/d/e/1FAIpQLSfwGYCxzlpzy05nsvR74vqMRqUt6DPvIDI2Sy4hsQDktRSwug/viewform?embedded=true" width="640" height="1015" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe-->
</div>


<script>
let url = location.search.substring(1);
let pid = new URLSearchParams(url).get('pid');
let num_videos = (pid % 2 == 0) ? 20 : 22;
let num_describers = (pid % 2 == 0) ? 10 : 11;

let intro = `Thank you for your time for participating in this user study. Here are ${num_videos} videos we are 
            asking you to watch and rate them in range of 1 through 5 (5 as the best). Is the audio 
            description well describing the video contents? Please consider that the volunteer describers 
            are all first time doing video descriptions. Each video is 2 minute long. These ${num_videos} videos are 
            actually only 2 different videos described by ${num_describers} different describers. Even though they are 
            repetitive, please listen to each description and rate the description quality and leave 
            comments for each video. At the end, there is a button confirming that you completed all videos. 
            For each video, there is a link to YouTube video, so click the play button. The YouTube video will be 
            played along with description audios.`;
$("#intro").append(intro);
</script>


<script>

  //get parameters from query string
//let url = location.search.substring(1);
let urlParams = new URLSearchParams(url);
let userId = urlParams.get('userId');
let targetUrl = '/userStudy/helper/video?userId=' + userId;
// console.log('target URL:' +  targetUrl);


$(document).ready(function () {
    getDateTime();
    fetchVideo();
});


function getDateTime(){
    let date = new Date(Date.now()).toLocaleString();
     document.getElementById('date').innerHTML = `Current time: ${date}`;
    // console.log(date);
}


function submitVideoData(userId, status) {
    let jsonBody = {
        "id": userId,
        "status": status,
    };
    $.ajax({
        type: 'PUT',
        url : "/userStudy/updateStatus",
        dataType: "json",
        async:true,
        crossDomain:true,
        data: jsonBody,
        success: function (response) {
            window.alert(JSON.stringify("Thank you for taking part in our study"));
        },
        error: function (response, textStatus, errorThrown) {
            window.alert(JSON.stringify(response));
        }
      });
}


function getVideoData1(userId){
    let url = "/userStudy/helperStatus?userId="+ userId;
      console.log({URL: url});
    $.get(url, function (rows) {
        console.log({LENGTH: rows.length});
        if(rows.length === 22){
            submitVideoData(userId, true);
        }else{
             window.alert("Please rate all the 22 videos");
        }
    });
}

function fetchVideo() {
    $.get(targetUrl, function (rows) {
        let videos = '';
        for (let i = 0; i < rows.length; i++) {
            let vid = rows[i];
            let videoId = vid.video_id;
            let videoTitle = vid.title;
            let volunteerId = vid.volunteer_id;
            let vi_userId= vid.vi_user_id;
            let vi_comment= vid.comment;
            let vi_rating=vid.rating;
            let vi_understanding = vid.video_understanding;
            let vi_ai_support = vid.ai_support.toString();
            // console.log({vi_ai_support});

            let aiSupportStr = vid.ai_support == 'true' ? 'With AI support' : 'Start from scratch';
            let aiParam = vid.ai_support ? 'yes' : 'no';
            let formid = ""+videoId + volunteerId + aiParam
            const stepperMsg = 'Please rate the description of this video on a scale of 1 to 5, with 1 being the poorest and 5 being the best';
            const understanding = 'I feel I have a good understanding of the topic covered in this video due to the video.';

            videos += `<b><a href="/playvideoaudio/${videoId}?u=${volunteerId}&ai=${aiParam}" class="list-group-item" >

                <img class="vid-thumbnail" src="https://i1.ytimg.com/vi/${videoId}/hqdefault.jpg" alt=${videoTitle} style="width:100px;height:100px;">
                Video ${i+1}: ${videoTitle}</a></b>
                  
                <form data-viuserid="${vi_userId}" data-videoid="${videoId}" data-volunteer_id="${volunteerId}" data-vi_ai_support="${vi_ai_support}"  class="video-form" method="POST">

                <label id="label_rating_${i+1}" for="rating_${i+1}"> ${stepperMsg}:</label> 
                <fieldset class='rating' id="group1_${i+1}" name="rating">
                    <input type="radio" name="rating" ${vi_rating==5?"checked":""} value="5" name="group1_${i+1}">5 - Excellent<br>
                    <input type="radio" name="rating" ${vi_rating==4?"checked":""} value="4" name="group1_${i+1}">4 - Good<br>
                    <input type="radio" name="rating" ${vi_rating==3?"checked":""} value="3" name="group1_${i+1}">3 - Average<br>
                    <input type="radio" name="rating" ${vi_rating==2?"checked":""} value="2" name="group1_${i+1}">2 - Fair<br>
                    <input type="radio" name="rating" ${vi_rating==1?"checked":""} value="1" name="group1_${i+1}">1 - Poor<br>
                </fieldset>
                <br>

                <label id="label_video_understanding_${i+1}" for="video_understanding${i+1}"> ${understanding}:</label> 
                <fieldset class='video_understanding' id="group2_${i+1}" name="video_understanding">
                    <input type="radio" name="video_understanding" ${vi_understanding==5?"checked":""} value="5" name="group2_${i+1}">Strongly Agree<br>
                    <input type="radio" name="video_understanding" ${vi_understanding==4?"checked":""} value="4" name="group2_${i+1}">Agree<br>
                    <input type="radio" name="video_understanding" ${vi_understanding==3?"checked":""} value="3" name="group2_${i+1}">Neutral<br>
                    <input type="radio" name="video_understanding" ${vi_understanding==2?"checked":""} value="2" name="group2_${i+1}">Disagree<br>
                    <input type="radio" name="video_understanding" ${vi_understanding==1?"checked":""} value="1" name="group2_${i+1}">Strongly Disagree<br>
                </fieldset>
                <br>
                
                <label id="label_comment_${i+1}" for="comment_${i+1}">Comment:</label> <input name="comment" aria-describedby="label_comment_${i+1}" type="text" id="comment_${i+1}" placeholder= "Please add comment" value= "${vi_comment ? vi_comment : "" }" style= "width: 75%; padding: 10px 7px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" name="comment"><br>
                <br>
                </form>`;   
                           
        }
        $(".list-group ").append( videos);
        $(".list-group ").append(`<button type="button" style= "width:100%;  background-color: #4CAF50; color: white; padding: 10px 10px; margin: 8px 0; border: none; border-radius: 4px;" onclick= "getVideoData1('${userId}')"> Done and send me Amazon Gift Card!</button>`);
    
        $(document).on("click", "list-group", function () {
            var a = $('input[name=active_status]:checked').val();  
            (OR)   
            var a = $('.active_status:checked').val();
            alert(a);
        });


        $(".video-form").bind('focusout',function() {
            //$( "#rating", "#comment" ).blur();
           // $( "#input" ).blur();
           $(this).toggleClass("#rating").toggleClass("#comment");
            // console.log( 'DATA', this.data);
            // debugger;
            let videoId = $(this).data("videoid")
            let volunteerId = $(this).data("volunteer_id")
            let vi_ai_support = $(this).data("vi_ai_support")
            let vi_userId = $(this).data("viuserid")

            var values ={}
            $.each($(this).serializeArray(), function(i, field) {
                // debugger;
                values[field.name] = field.value;
            })

            if (values["rating"] == '') {
                values["rating"] = 0;
            }

            $.ajax({
                type: "POST",
                url:"/updatefeedback",
                data: {
                    vi_user_id: vi_userId,
                    video_id: videoId,
                    volunteer_id: volunteerId,
                    ai_support: vi_ai_support,
                    rating: values["rating"], 
                    comment: values["comment"],
                    video_understanding : values["video_understanding"]
                },
                beforeSend: function() {
                    console.log("Before send.")
                    
                },
                success: function(){
                    console.log("success connected");
                },
                fail: function() {
                    console.log("Failed.")
                },
                dataType: "json"
            })

            return false;
        })
    });

    
}
</script>

</body>
