<!DOCTYPE html>
<head>
    <title>User Study</title>
    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
   <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
   <script src="https://code.jquery.com/jquery-3.4.1.js"   integrity="sha256-WpOohJOqMqqyKL9FccASB9O0KwACQJpFTUBLTYOVvVU="   crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>  
    <link rel="stylesheet" href="stylesheets/uploadVideo.css">    
    <script src="javascripts/uploadVideo.js"></script>
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
    <a class="navbar-brand" href="#">You Describe</a>
</nav>
<div id="container1">
    <form id="uploadVideoForm">
        <div class="form-group">
            <label for="youtubeId">Youtube Id</label>
            <input type="text" class="form-control" id="youtubeId" placeholder="Please enter the youtube id">
            <small class="form-text text-muted">Please provide the youtube id of the video. This id will be used to play the video from the youtube</small>
        </div>
        <div class="form-group">
            <label for="VideoName">Name of the Video</label>
            <input type="text" class="form-control" id="videoName" placeholder="Please enter name of the video">
        </div>
        <div class="form-group">
            <label for="videoId">Video Id</label>
            <input type="text" class="form-control" id="videoId" placeholder="" disabled="disabled">
            <small class="form-text text-muted">Please provide the youtube id of the video.</small>
        </div>
      
        <div class="form-group">
            <label for="upload">Upload video file</label>
            <input type="file" class="form-control-file" id="file" name="file">
            <button id="submitVideo" type="submit" class="btn btn-primary">Upload Video</button>
        </div>
    </form>

    <form id="videoInsightForm">
        <div class="form-group">
            <label for="Insight">Video Insight</label>
            <textarea class="form-control" rows="5" id="insight"></textarea>
            <button id="btnInsight" type="submit" class="btn btn-primary">Get Insight</button>
        </div>
    </form>
    <br>

    <form id="audioUploadForm">
        <div class="form-group">
            Audio File: <input type="file" name="audiofile"><br>
            Your Callback Url: <input type="text" id="callbackText" name="callbackurl" value=""><br>
            <input type="hidden" name="appkey" value="yAOzHAy9LQBJQGtshcIGJX368IbC4Enx">
            <button id="submitAudio" type="submit" class="btn btn-primary">Upload Audio</button>
        </div>
    </form>

    <form id="audioInsightForm">
        <div class="form-group">
            <label for="Insight">Audio Insight</label>
            <input type="text" name="orderid" id="orderid" value="OIVLXP20200212110759">
            <button id="btnAudioInsight" type="submit" class="btn btn-primary">Get Audio Insight</button>
            <textarea class="form-control" rows="5" id="audioInsight"></textarea>
        </div>
    </form>

    <button id="btnMerge" class="btn btn-warning"> Merge Scenes</button>    
</div>




</body>
</html>