<!DOCTYPE html>
<html>
<head>
    <title>YouDescribe Prototype</title>
    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="stylesheets/style.css">
    <script src="javascripts/addvideo.js"></script>
</head>
<body>
    <hr>
    <h2>Enter New Video Data</h1>
    <div id="inputAreaDiv">
        <table>
            <tr><td>Youtube ID:</td><td><input id="youtubeId" value=""></td></tr>
            <tr><td>Title:</td><td><input id="title" value=""></td></tr>
            <tr><td>Video Indexer JSON:</td><td><textarea id="inputJson" rows = "5" cols = "50"></textarea></td></tr>
            <tr><td><button id="btnSubmit">Submit</button></td></tr>
        </table>
    </div>
    <hr>
    <h2>Reset Database</h1>
    <button id="btnClearDb">Clear Database</button>
    <hr>
</body>
</html>